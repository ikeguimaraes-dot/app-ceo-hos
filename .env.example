# Use mock para a demonstração isolada ou remote para os contratos Ghost v1.
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_DATA_MODE=mock

# Obrigatórios apenas em remote. Use a Project URL e uma publishable key.
# Nunca use service_role, secret key ou credencial administrativa no aplicativo.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
