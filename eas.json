{
  "cli": { "version": ">= 16.0.0" },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_APP_ENV": "local", "EXPO_PUBLIC_DATA_MODE": "mock" }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_DATA_MODE": "remote"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_DATA_MODE": "remote"
      }
    }
  }
}
